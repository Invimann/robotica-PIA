<?xml version="1.0" ?>
<!--
  corridor.sdf  —  Enclosed rectangular arena (6 m × 3 m).
  Purpose   : stress-test the FSM. The robot is fully enclosed, so it
              will keep triggering state transitions indefinitely.
              Each left turn sends it toward the next wall in sequence:
                east wall → back → left → north wall → back → left →
                west wall → back → left → south wall → back → left →
                east wall → … (cycle repeats)
  Note      : Unlike obstacles.sdf, there is no "escape route". This is
              intentional — use it to observe long-term FSM behaviour
              and discuss why a fixed left-turn cannot guarantee
              wall-following or goal-reaching.
  Robot spawns at (0, 0, 0) facing +x (east).
  Usage     : ros2 launch fsm_demo sim.launch.py world:=corridor
-->
<sdf version="1.9">
  <world name="corridor">

    <!-- ── gz-sim system plugins ──────────────────────────────────────── -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- ── Scene ──────────────────────────────────────────────────────── -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.6 0.7 0.9 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ── Ground plane ───────────────────────────────────────────────── -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── Arena walls ────────────────────────────────────────────────── -->
    <!--
      Arena layout (top-down). All coordinates in metres.
      Robot spawns at ✱, near the west end, facing east (→).

      West x=-1  East x=5
           │              │
      N y=1.5 ┌───────────┐
           │  │           │
           │  │   ✱  →   │
           │  │           │
      S y=-1.5└───────────┘
    -->

    <!-- East wall — first obstacle the robot will detect -->
    <model name="wall_east">
      <static>true</static>
      <!-- Centre: x=5.05  y=0  z=0.25 -->
      <pose>5.05 0.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 3.1 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 3.1 0.5</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- West wall — behind the spawn point -->
    <model name="wall_west">
      <static>true</static>
      <pose>-1.05 0.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 3.1 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 3.1 0.5</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- North wall — robot faces this after its first left turn -->
    <!-- Spans the full width: from x=-1 to x=5, centre at x=2.0 -->
    <model name="wall_north">
      <static>true</static>
      <pose>2.0 1.55 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>6.1 0.1 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6.1 0.1 0.5</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- South wall -->
    <model name="wall_south">
      <static>true</static>
      <pose>2.0 -1.55 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>6.1 0.1 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6.1 0.1 0.5</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>